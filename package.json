{
  "name": "@ondewo/ondewo-nlu-client-js",
  "version": "6.14.0",
  "description": "ONDEWO Natural Language Understanding (NLU) Client library for Js",
  "author": "ONDEWO GmbH <office@ondewo.com>",
  "homepage": "https://ondewo.com",
  "license": "Apache-2.0",
  "keywords": [
    "ondewo",
    "nlu",
    "api",
    "client",
    "js",
    "grpc"
  ],
  "files": [
    "api/ondewo_nlu_api.js",
    "api/ondewo_nlu_api.min.js",
    "api/ondewo_nlu_api.min.js.map",
    "auth/offlineTokenProvider.js"
  ],
  "repository": {
    "type": "git",
    "directory": "https://github.com/ondewo/ondewo-nlu-client-js.git"
  },
  "scripts": {
    "prepare": "husky",
    "test": "c8 --100 --per-file --all --include 'auth/**/*.js' --include 'example/**/*.js' --exclude '**/*.spec.js' --reporter text node --test auth/offlineTokenProvider.spec.js example/listAgents.spec.js example/client.spec.js",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "google-protobuf": "^3.21.4",
    "grpc-web": "^1.5.0",
    "terser-webpack-plugin": "^5.3.14",
    "undici": "^6.27.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.27",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "global": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.4",
    "dotenv": "^16.4.5",
    "typescript": "6.0.3"
  }
}
